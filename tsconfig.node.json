{
  "compilerOptions": {
    // "composite": true, // Often not needed without project references, remove if it iscausing issues
    "skipLibCheck": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "target": "ES2022",
    "outDir": "dist-electron", // Explicitly set base output directory
    "rootDir": "electron", // Specify the root source directory
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": false
  },
  "include": [
    "electron/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
