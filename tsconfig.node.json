{
  "compilerOptions": {
    "skipLibCheck": true,
    "module": "CommonJS",
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "target": "ES2022",
    "outDir": "dist-electron",
    "rootDir": ".",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": [
    "electron/**/*.ts",
    "src/types/**/*.ts",
    "src/services/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
