{
  "compilerOptions": {
    // "composite": true, // Often not needed without project references, remove if causing issues
    "skipLibCheck": true,
    "module": "CommonJS",
    "moduleResolution": "Node",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "target": "ES2022",
    "outDir": "dist-electron", // Explicitly set base output directory
    "rootDir": "electron", // Specify the root source directory
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": false, // Keep false if needed for commonjs output
    "types": ["node", "electron"], // Explicitly specify types
    "declaration": false,
    "allowJs": false,
    "checkJs": false
  },
  "include": [
    "electron/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
